# Firebase Admin credentials stay server-only. Web SDK fields below are public.
# Public origin for link previews; leave empty to use the request's origin.
HYPED_SITE_URL=

FIREBASE_PROJECT_ID=demo-hyped
FIREBASE_STORAGE_BUCKET=demo-hyped.firebasestorage.app

# Comma-separated, exact Google account emails allowed to edit page covers.
HYPED_EDITOR_EMAILS=approved.account@example.com

# Optional GitHub Wiki repository. Defaults to the current checked integration.
HYPED_GITHUB_WIKI_REPOSITORY=Hyp-ed/hyped-2027

# Local web-app config from Firebase Console > Project settings > Your apps.
# App Hosting supplies FIREBASE_WEBAPP_CONFIG at build time for a linked Web App.
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_APP_ID=
FIREBASE_AUTH_DOMAIN=

# Optional scheduler authentication (runtime secret, at least 32 characters).
# Leave unset to disable /api/internal/wiki-sync.
HYPED_WIKI_SYNC_SECRET=

# Optional local Firestore and Storage emulator endpoints.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
