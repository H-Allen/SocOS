# Firebase is server-only. App Hosting supplies credentials in production.
FIREBASE_PROJECT_ID=demo-hyped
FIREBASE_STORAGE_BUCKET=demo-hyped.firebasestorage.app

# Comma-separated, exact Google account emails allowed to edit page covers.
HYPED_EDITOR_EMAILS=approved.account@example.com

# Optional GitHub Wiki repository. Defaults to the current checked integration.
HYPED_GITHUB_WIKI_REPOSITORY=Hyp-ed/hyped-2025

# Local web-app config from Firebase Console > Project settings > Your apps.
# App Hosting supplies FIREBASE_WEBAPP_CONFIG automatically in production.
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_APP_ID=
FIREBASE_AUTH_DOMAIN=

# Optional local Firestore and Storage emulator endpoints.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
